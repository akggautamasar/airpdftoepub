{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdfepub-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "RENDER_URL": "https://pdfepub-compute.onrender.com",
    "ALLOWED_ORIGINS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pdfepub-db",
      "database_id": "3803a7bf-5310-4bff-a7d7-edc5732195e8",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FILES",
      "id": "c8b9216d235949fdb3d794eb72184fc9"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS_QUEUE",
        "queue": "pdfepub-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "pdfepub-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 4,
        "retry_delay": 60
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
